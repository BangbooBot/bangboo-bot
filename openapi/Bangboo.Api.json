    "/api/guilds/{guildId}/mousetrap": {
      "get": {
        "tags": [
          "Mousetrap"
        ],
        "summary": "Configuração do mousetrap.",
        "description": "Canal-armadilha: quem enviar mensagem nele é punido (pega contas hackeadas que mandam spam).\nSe nunca foi configurado, retorna o padrão (desativado).",
        "parameters": [
          {
            "name": "guildId",
            "in": "path",
            "description": "ID da guild no Discord.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MousetrapResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Mousetrap"
        ],
        "summary": "Salva a configuração do mousetrap.",
        "description": "Regras: ativar exige um canal de texto do servidor; `byTenure` exige `minTenureDays`;\n`sendDm` exige `dmMessage`. O bot aplica a nova configuração em até 30 s.",
        "parameters": [
          {
            "name": "guildId",
            "in": "path",
            "description": "ID da guild no Discord.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Token de cancelamento.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMousetrapRequest"
              }
            },
            "text/json": {
              "schema": {
