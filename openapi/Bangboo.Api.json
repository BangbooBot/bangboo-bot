    "/api/status": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Status do bot.",
        "description": "Online/offline (pelo heartbeat do bot), servidores, latência e quantidade de comandos.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [ ]
      }
    },
    "/api/status/commands": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Slash commands do bot.",
        "description": "Comandos registrados no Discord, em ordem alfabética, com parâmetros, escolhas e se são só\npara servidores. Com locale (ex.: `pt-BR`), as descrições vêm traduzidas\nquando o bot registrou a tradução; senão, em inglês.",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "description": "Idioma das descrições (ex.: `en`, `pt-BR`).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommandResponse"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [ ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "required": [
          "status",
          "message"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "Código HTTP (repetido no corpo para facilitar o consumo no front).",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "description": "Mensagem legível, segura para exibir ao usuário."
          }
        },
        "description": "Corpo padrão de TODA resposta de erro da API."
      },
      "CommandOptionResponse": {
        "required": [
          "name",
          "description",
          "type",
          "required",
          "choices",
          "options"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do parâmetro."
          },
          "description": {
            "type": "string",
            "description": "Descrição no idioma pedido, ou a padrão."
          },
          "type": {
            "type": "string",
            "description": "Tipo: subcommand, subcommand-group, string, integer, boolean, user, channel, role, mentionable, number, attachment."
          },
          "required": {
            "type": "boolean",
            "description": "Obrigatório ao usar o comando."
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Valores fixos aceitos (vazio = livre)."
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommandOptionResponse"
            },
            "description": "Parâmetros do subcomando (vazio para parâmetros comuns)."
          }
        },
        "description": "Parâmetro (ou subcomando) de um slash command."
      },
      "CommandResponse": {
        "required": [
          "name",
          "description",
          "guildOnly",
          "options"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do comando (sem a barra)."
          },
          "description": {
            "type": "string",
            "description": "Descrição no idioma pedido, ou a padrão (inglês) se não houver tradução."
          },
          "guildOnly": {
            "type": "boolean",
            "description": "O comando só funciona dentro de servidores (não em DMs)."
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommandOptionResponse"
            },
            "description": "Parâmetros e subcomandos, na ordem do Discord."
          }
        },
        "description": "Slash command do bot."
      },
      "GuildChannelResponse": {
        "required": [
          "id",
          "name",
          "category"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID do canal."
          },
          "name": {
            "type": "string",
            "description": "Nome (sem #)."
          },
          "category": {
            "type": [
              "null",
              "string"
            ],
            "description": "Categoria em que está, se houver."
          }
        },
        "description": "Canal de texto da guild (para seletores do dashboard)."
      },
      "GuildOverviewResponse": {
        "required": [
          "id",
          "name",
          "iconUrl",
          "bannerUrl",
          "description",
          "ownerId",
          "createdAt",
          "memberCount",
          "onlineCount",
          "boostTier",
          "boostCount",
          "textChannelCount",
          "voiceChannelCount",
          "categoryCount",
          "roleCount",
          "preferredLocale",
          "mousetrap"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID da guild."
          },
          "name": {
            "type": "string",
            "description": "Nome."
          },
          "iconUrl": {
            "type": [
              "null",
              "string"
            ],
