{
  "openapi": "3.1.1",
  "info": {
    "title": "Bangboo API",
    "description": "API do dashboard do Bangboo. Erros sempre retornam `{ status, message }`. A autenticação é feita por cookie (`bangboo.auth`) criado em `GET /api/auth/login`.",
    "version": "v1"
  },
  "paths": {
    "/api/auth/login": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Inicia o login com Discord.",
        "description": "Redireciona para o OAuth do Discord. Após o login, o cookie `bangboo.auth` é criado e o\nnavegador volta para returnUrl (apenas caminhos relativos; padrão `/dashboard`).\nAbra esta URL como navegação de página, não via fetch.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "description": "Caminho do dashboard para voltar após o login.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Found"
          }
        },
        "security": [ ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Encerra a sessão.",
        "description": "Remove o cookie de autenticação. Idempotente: responde 204 mesmo sem sessão.",
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [ ]
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Usuário logado.",
        "description": "Retorna o perfil do usuário da sessão atual, ou 401 se não houver sessão.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/guilds": {
      "get": {
        "tags": [
          "Guilds"
        ],
        "summary": "Guilds gerenciáveis.",
        "description": "Guilds em que o usuário é dono, Administrator ou tem Manage Server.\n`isBotMember` indica se o bot já está na guild.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GuildResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/guilds/{guildId}": {
      "get": {
        "tags": [
          "Guilds"
        ],
        "summary": "Detalhes de uma guild.",
        "description": "Exige permissão de gerenciar a guild.",
        "parameters": [
          {
            "name": "guildId",
            "in": "path",
            "description": "ID da guild no Discord.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuildResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/guilds/{guildId}/overview": {
      "get": {
        "tags": [
          "Guilds"
        ],
        "summary": "Visão geral do servidor.",
