    "/api/guilds/{guildId}/moderation": {
      "get": {
        "tags": [
          "Moderation"
        ],
        "summary": "Cargos que podem usar o comando /moderate.",
        "description": "O dono e quem tem Administrador sempre podem, mesmo sem cargo listado. 404 se o bot não estiver no servidor.",
        "parameters": [
          {
            "name": "guildId",
            "in": "path",
            "description": "ID da guild no Discord.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModerationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
